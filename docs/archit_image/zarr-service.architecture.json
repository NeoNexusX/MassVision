    {
      "dot": "cyan",
      "title": "Dual Layout Support",
      "items": [
        "v1.0: single data/ group (ion-major or pixel-major)",
        "v1.1: ion_image/ (continuous) + spectra/ (processed) dual groups",
        "Probes candidates in order: data → ion_image → spectra",
        "Each layout determines row_axis, encoding, and read strategy"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cache & Concurrency",
      "items": [
        "3 independent LRU caches: intensity (20), mz (5), spectra (100)",
        "In-flight dedup maps: concurrent chunk reads share one promise",
        "Batch size 6 for 1D reads, 12 for full scans (browser connection limit)",
        "Producer-consumer pool (16 workers) for spectra streaming"
      ]
    },
    {
      "dot": "rose",
      "title": "Error Resilience",
      "items": [
        "404 chunk → fill-value reconstruction (sparse export, not error)",
        "STS expiry → proactive margin (60s) + reactive retry on 403/token_expired",
        "STS refresh dedup: concurrent callers share one backend round-trip",
        "Corrupt/oversized chunks → throw/truncate; disposed store returns empty"
      ]
    }
  ]
