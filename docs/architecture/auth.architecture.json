  "cards": [
    {
      "dot": "cyan",
      "title": "Auth Flow",
      "items": [
        "User submits credentials → useLoginForm calls authApi.login()",
        "Backend returns JWT access_token → authStore stores in localStorage",
        "httpClient attaches Bearer token to all API requests",
        "Router guard checks token + fetches user profile on protected routes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Security Features",
      "items": [
        "Cross-tab logout sync via storage event listener",
        "401 responses auto-clear token and redirect to /login",
        "Admin routes require isAdmin check after profile fetch",
        "In-flight fetchUser dedup prevents concurrent GET /user calls"
      ]
    }
  ]
