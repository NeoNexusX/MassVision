    {
      "date": {
        "en": "September 11",
        "zh-CN": "9月11日"
      },
      "version": "0.7.1",
      "features": [
        {
          "en": "Collections hub: curate and share public imzML datasets",
          "zh-CN": "合集中心：整理并分享公开 imzML 数据集"
        },
        {
          "en": "Collection editing: metadata, members and drag-to-reorder",
