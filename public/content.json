        },
        {
          "en": "Share public collections without sign-in",
          "zh-CN": "公开合集免登录分享"
        },
        {
          "en": "Multi-ion overlay and ROI/KMeans mask export (.npy / .csv)",
          "zh-CN": "多离子叠加与 ROI/KMeans 掩膜导出（.npy / .csv）"
        },
        {
          "en": "Dataset metadata editing (incl. solvent) with server-side sorting",
          "zh-CN": "数据集元数据编辑（含溶剂）与服务端排序"
        },
        {
          "en": "Streaming multipart upload with abort and resume",
          "zh-CN": "流式分片上传，支持中止与续传"
        }
      ]
    },
