{
  "appName": "SpatialXomics",
  "version": "0.6.1",
  "zarr": {
    "spectraChunkCacheSize": 100,
    "spectraConcurrency": 16
  },
  "oss": {
    "previewImageBase": "https://kawaru-oss.oss-cn-hangzhou.aliyuncs.com"
  },
  "pagination": {
    "defaultPageSize": 10,
    "pageSizeOptions": [
      6,
      10,
      20
    ]
  },
  "verification": {
    "countdownSeconds": 60,
    "maxAttempts": 10
  },
  "carousel": {
    "interval": 3000,
    "endPause": 5000
  },
  "nav": {
    "mode": "navbar",
    "modeByPath": {
      "/": "none",
      "/login": "drawer",
      "/register": "drawer",
      "/workspace/results": "drawer"
    },
    "themeToggle": true,
    "guestHint": "Sign in",
    "items": [
      {
        "kind": "link",
        "to": "/",
        "icon": "home",
        "label": "Home",
        "active": true
      },
      {
        "kind": "group",
        "icon": "circle_stack",
        "label": "Datahub",
        "active": true,
        "children": [
          {
            "to": "/datasets",
            "icon": "queue_list",
            "label": "Public Datasets",
            "active": true
          },
          {
            "to": "/mydatasets",
            "icon": "folder",
            "label": "My Datasets",
            "active": true,
            "requireAuth": true
          }
        ]
      },
      {
        "kind": "group",
        "icon": "code-bracket",
        "label": "Workspace",
        "active": true,
        "children": [
          {
            "to": "/workspace",
            "icon": "code-bracket",
            "label": "Workspace",
            "active": true
          },
          {
            "to": "/workspace/new",
            "icon": "plus",
            "label": "New Analysis",
            "active": true
          }
        ]
      },
      {
        "kind": "link",
        "to": "/docs/",
        "icon": "book",
        "label": "Documentation",
        "active": true,
        "external": true
      }
    ],
    "userMenu": [
      {
        "kind": "link",
        "to": "/profile",
        "icon": "user-circle",
        "label": "Profile",
        "active": true
      },
      {
        "kind": "link",
        "to": "/users",
        "icon": "users",
        "label": "Users",
        "active": true,
        "requireAdmin": true
      },
      {
        "kind": "action",
        "action": "logout",
        "label": "Sign out",
        "active": true
      }
    ],
    "guestLinks": [
      {
        "to": "/login",
        "icon": "signin",
        "label": "Sign in",
        "active": true
      },
      {
        "to": "/register",
        "icon": "user_plus",
        "label": "Create account",
        "active": true,
        "primary": true
      }
    ]
  },
  "fab": {
    "main": {
      "iconClosed": "bars3",
      "iconOpen": "close"
    },
    "items": [
      {
        "kind": "action",
        "action": "toggle-theme",
        "icon": "sun",
        "label": "Toggle theme",
        "active": true
      },
      {
        "kind": "action",
        "action": "toggle-ai",
        "icon": "sparkles",
        "label": "AI Assistant",
        "active": false,
        "requireAuth": true
      },
      {
        "kind": "action",
        "action": "logout",
        "icon": "signin",
        "label": "Sign out",
        "active": true,
        "requireAuth": true
      }
    ]
  }
}
