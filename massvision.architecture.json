  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend Architecture",
      "items": [
        "Feature-sliced vertical slices, strict layering: shared ← services ← features ← views",
        "Minimal Pinia (auth/download only); composables are the stateful core",
        "Custom Zarr v3 chunked reader + browser-side KMeans + Worker compression/parsing",
        "Config-before-mount bootstrap; runtime config editable post-deploy"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data Flows",
      "items": [
        "REST CRUD: composable → api → httpClient → FastAPI → mappers → components",
        "Zarr binary: useZarrIonImage → STS → ali-oss → OSS chunked reads (LRU cache)",
        "Upload pipeline: imzML parse → MD5 dedup → ZIP64 OPFS → multipart OSS → registration",
        "Compute: backend UMAP + browser KMeans worker + CSV annotation worker"
      ]
    },
    {
      "dot": "rose",
      "title": "Infrastructure",
      "items": [
        "Vite 7 build + build-time gzip/brotli precompression + Nginx static serving",
        "Docker deployment, GitHub Actions CI/CD (test/dev/main branches)",
        "Alibaba Cloud OSS for binary data; STS temp credentials for browser-direct upload",
        "FastAPI backend as independent service; JWT auth + STS signing"
      ]
    }
  ]
