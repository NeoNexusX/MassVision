# ============================================================
# 生产构建环境变量
# 仅在 vite build 时生效，会被注入到 dist/ 产物中
# ============================================================

# 生产环境前端 API 基路径（通常与 .env 公共默认一致，显式声明以明确意图）
VITE_API_BASE=/api

# vite preview 静态服务器 proxy 目标（仅 vite.config.ts 使用，不注入 dist 产物）
VITE_BACKEND_URL=http://47.98.174.83:8000
