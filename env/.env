# ============================================================
# 公共默认值：所有环境共享的变量
# 环境专属覆盖见：.env.development / .env.production
# 开发者私有覆盖见：.env.development.local（gitignore 已覆盖 *.local）
# ============================================================

# 前端 API 基路径（同源请求，dev 走 vite proxy，prod 走 nginx proxy）
VITE_API_BASE=/api

# OSS 加速域名（所有 bucket 共用同一个加速 endpoint）
VITE_OSS_ENDPOINT=oss-accelerate.aliyuncs.com
